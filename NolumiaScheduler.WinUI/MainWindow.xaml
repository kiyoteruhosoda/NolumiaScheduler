<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NolumiaScheduler.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NolumiaScheduler.WinUI"
    Title="NolumiaScheduler">

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="{x:Bind CanGoBack, Mode=OneWay}"
                    BackRequested="OnBackRequested"
                    ItemInvoked="OnNavItemInvoked"
                    IsPaneToggleButtonVisible="True"
                    IsPaneOpen="False"
                    IsSettingsVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="MonthNavItem" Tag="Month">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE787;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="WeekNavItem" Tag="Week">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8C0;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="WeekdaysNavItem" Tag="Weekdays">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BF;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <!-- Opens its own window; the calendar stays the selected page. -->
            <NavigationViewItem x:Name="SyncStatusNavItem" Tag="SyncStatus" SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE895;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" NavigationFailed="OnNavigationFailed"/>
    </NavigationView>
</Window>
