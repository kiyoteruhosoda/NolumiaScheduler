<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NolumiaScheduler.WinUI.Presentation.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

            <TextBlock x:Name="PageTitleText"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,4"/>

            <!-- Theme -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="ThemeLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <ComboBox x:Name="ThemePicker"
                          MinWidth="200"
                          SelectionChanged="OnThemeSelectionChanged"/>
            </StackPanel>

            <!-- Language -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="LanguageLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <ComboBox x:Name="LanguagePicker"
                          MinWidth="200"
                          SelectionChanged="OnLanguageSelectionChanged"/>
            </StackPanel>

            <!-- Startup view -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="StartupViewLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <ComboBox x:Name="StartupViewPicker"
                          MinWidth="200"
                          SelectionChanged="OnStartupViewSelectionChanged"/>
            </StackPanel>

            <!-- Scheduler server: sign-in and the one-time move of this PC's events -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="ServerLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="ServerModeText"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock x:Name="ServerAccountText"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton"
                            MinHeight="48"
                            Click="OnSignInClick"/>
                    <Button x:Name="SignOutButton"
                            MinHeight="48"
                            Click="OnSignOutClick"/>
                </StackPanel>
                <Button x:Name="MigrateButton"
                        MinHeight="48"
                        Click="OnMigrateClick"/>
                <TextBlock x:Name="ServerResultText"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- Version (git describe + build time, stamped at build) -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="VersionLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="VersionValueText"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <!-- Shown only when a newer version has been downloaded (task #551) -->
                <TextBlock x:Name="UpdateReadyText"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <Button x:Name="UpdateNowButton"
                        Visibility="Collapsed"
                        MinHeight="48"
                        Click="OnUpdateNowClick"/>
            </StackPanel>

            <!-- Storage backend + data folder -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="StorageLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="StorageValueText"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <HyperlinkButton x:Name="OpenDataFolderButton"
                                 MinHeight="48"
                                 Padding="0"
                                 Click="OnOpenDataFolderClick"/>
            </StackPanel>

            <!-- Diagnostics: log folder and how the previous run ended -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="DiagnosticsLabelText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="DiagnosticsDescriptionText"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock x:Name="LastSessionText"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <HyperlinkButton x:Name="OpenLogFolderButton"
                                 MinHeight="48"
                                 Padding="0"
                                 Click="OnOpenLogFolderClick"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
