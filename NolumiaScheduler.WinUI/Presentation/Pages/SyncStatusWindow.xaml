<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NolumiaScheduler.WinUI.Presentation.Pages.SyncStatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="0">

            <!-- ═══ Header: Clock + Buttons ═══ -->
            <TextBlock x:Name="ClockLabel" FontSize="20" FontWeight="Bold"
                       IsTextSelectionEnabled="True" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button x:Name="SendNowButton" Click="OnSendNowClicked" />
                <Button x:Name="ReadNowButton" Click="OnReadNowClicked" />
                <Button x:Name="CopyButton" Click="OnCopyClicked" />
                <Button x:Name="OpenLogFolderButton" Click="OnOpenLogFolderClicked" />
            </StackPanel>

            <!-- ═══ Section 1: Findings ═══ -->
            <TextBlock x:Name="ProblemsHeaderLabel" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="ProblemsLabel" FontSize="13"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <!-- ═══ Section 2: Server ═══ -->
            <TextBlock x:Name="ServerHeaderLabel" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="ServerLabel" FontSize="11" FontFamily="Consolas"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <!-- ═══ Section 3: Outlook ═══ -->
            <TextBlock x:Name="OutlookHeaderLabel" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="OutlookLabel" FontSize="11" FontFamily="Consolas"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <!-- ═══ Section 4: Today's Outlook events in the app ═══ -->
            <TextBlock x:Name="TodayHeaderLabel" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="TodayLabel" FontSize="11" FontFamily="Consolas"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <!-- ═══ Section 5: Recent log ═══ -->
            <TextBlock x:Name="LogHeaderLabel" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="LogLabel" FontSize="11" FontFamily="Consolas"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</Window>
